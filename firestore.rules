rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() { return userDoc().data.role; }
    function unidad() { return userDoc().data.unidadId; }

    function isDpto() { return role() in ['admin_dpto', 'super_admin']; }
    function isDptoReader() { return role() in ['visor_dpto', 'admin_dpto', 'super_admin']; }
    function isUnidadScope() { return role() in ['operador_unidad', 'admin_unidad']; }
    function canReadUnidad(unidadId) {
      return isDptoReader() || (isUnidadScope() && unidadId == unidad());
    }

    function sameUnidad(resourceUnidadId) {
      return isUnidadScope() && resourceUnidadId == unidad();
    }

    function canReadTransfer(data) {
      return isDpto() || (
        isUnidadScope() && (
          data.fromUnidadId == unidad() ||
          data.toUnidadId == unidad()
        )
      );
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || isDpto());
      allow write: if false;
    }

    match /personal/{id} {
      allow read: if isSignedIn() && canReadUnidad(resource.data.unidadId);
      allow write: if false;
    }

    match /faltas/{id} {
      allow read: if isSignedIn() && canReadUnidad(resource.data.unidadId);
      allow write: if false;
    }

    match /solicitudes_eliminacion_falta/{id} {
      allow read: if isSignedIn() && (isDpto() || sameUnidad(resource.data.solicitanteUnidadId));
      allow write: if false;
    }

    match /audit_logs/{id} {
      allow read: if isSignedIn() && isDpto();
      allow write: if false;
    }

    match /imports_personal/{id} {
      allow read: if isSignedIn() && isDpto();
      allow write: if false;
    }

    match /imports_sanciones/{id} {
      allow read: if isSignedIn() && role() == 'super_admin';
      allow write: if false;

      match /rows/{rowId} {
        allow read: if isSignedIn() && role() == 'super_admin';
        allow write: if false;
      }
    }

    match /transferencias_logs/{id} {
      allow read: if isSignedIn() && isDpto();
      allow write: if false; // Only written via Admin SDK
    }

    match /transferencias_solicitudes/{id} {
      allow read: if isSignedIn() && canReadTransfer(resource.data);
      allow write: if false;
    }

    match /reincidencias_bloqueadas/{id} {
      allow read: if isSignedIn() && (isDptoReader() || sameUnidad(resource.data.unidadIntentoId));
      allow write: if false; // Only written via Admin SDK
    }

    match /unidades/{id} {
      allow read: if isSignedIn() && (isDptoReader() || (isUnidadScope() && resource.data.id == unidad()));
      allow write: if false;
    }

    match /ci_registry/{id} {
      allow read: if isSignedIn() && isDpto();
      allow write: if false;
    }

    match /integraciones_sanciones/{id} {
      allow read: if isSignedIn() && isDpto();
      allow write: if false;
    }
  }
}
