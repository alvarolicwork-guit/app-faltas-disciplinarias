rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() { return userDoc().data.role; }
    function unidad() { return userDoc().data.unidadId; }

    function isSuper() { return role() == 'super_admin'; }
    function isDpto() { return role() in ['admin_dpto', 'super_admin']; }
    function isDptoReader() { return role() in ['visor_dpto', 'admin_dpto', 'super_admin']; }
    function isUnidadScope() { return role() in ['operador_unidad', 'admin_unidad']; }
    function canWriteFaltas() { return role() in ['admin_unidad', 'admin_dpto', 'super_admin']; }
    function canReadUnidad(unidadId) {
      return isDptoReader() || (isUnidadScope() && unidadId == unidad());
    }

    function sameUnidad(resourceUnidadId) {
      return isUnidadScope() && resourceUnidadId == unidad();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || isDpto());
      allow write: if isSignedIn() && isSuper();
    }

    match /personal/{id} {
      allow read: if isSignedIn() && canReadUnidad(resource.data.unidadId);
      allow create, update, delete: if isSignedIn() && isDpto();
    }

    match /faltas/{id} {
      allow read: if isSignedIn() && canReadUnidad(resource.data.unidadId);
      allow create, update: if isSignedIn() && canWriteFaltas() && (isDpto() || sameUnidad(request.resource.data.unidadId));
      allow delete: if isSignedIn() && isDpto();
    }

    match /solicitudes_eliminacion_falta/{id} {
      allow read: if isSignedIn() && (isDpto() || sameUnidad(resource.data.solicitanteUnidadId));
      allow create: if isSignedIn() && (isDpto() || sameUnidad(request.resource.data.solicitanteUnidadId));
      allow update: if isSignedIn() && isDpto();
      allow delete: if false;
    }

    match /audit_logs/{id} {
      allow read: if isSignedIn() && isDpto();
      allow write: if false;
    }

    match /imports_personal/{id} {
      allow read, create: if isSignedIn() && isDpto();
      allow update, delete: if isSignedIn() && isSuper();
    }

    match /transferencias_logs/{id} {
      allow read: if isSignedIn() && isDpto();
      allow write: if false; // Only written via Admin SDK
    }

    match /reincidencias_bloqueadas/{id} {
      allow read: if isSignedIn() && (isDpto() || sameUnidad(resource.data.unidadIntentoId));
      allow write: if false; // Only written via Admin SDK
    }

    match /unidades/{id} {
      allow read: if isSignedIn() && (isDptoReader() || (isUnidadScope() && resource.data.id == unidad()));
      allow create, update, delete: if isSignedIn() && isDpto();
    }
  }
}
