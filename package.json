{
  "name": "app-faltas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:imports": "tsx --test src/lib/imports/historical-sanctions.test.ts src/lib/imports/recurrence-import.test.ts",
    "test:domain": "tsx --test src/lib/domain/sanction-policy.test.ts src/lib/domain/recurrence-chain.test.ts src/lib/domain/personal-search.test.ts src/lib/server/local-test-policy.test.ts",
    "test:emulator": "firebase emulators:exec --only \"firestore,auth\" --project demo-app-faltas --config firebase.test.json \"node --import tsx --test --test-concurrency=1 src/lib/server/workflow.emulator.test.ts src/lib/server/recurrence.emulator.test.ts\"",
    "test:e2e": "firebase emulators:exec --only \"firestore,auth\" --project demo-app-faltas --config firebase.test.json \"node --import tsx scripts/e2e-functional.mjs\"",
    "bootstrap:super-admin": "node --env-file=.env.local scripts/bootstrap-super-admin.mjs",
    "smoke:reincidencia": "node --env-file=.env.local scripts/smoke-reincidencia.mjs",
    "data:cleanup:preview": "node --env-file=.env.local scripts/cleanup-production-data.mjs --mode=preview",
    "data:cleanup": "node --env-file=.env.local scripts/cleanup-production-data.mjs --mode=execute",
    "dev:demo": "node scripts/run-local-demo.mjs"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "next": "^16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "debug": "^4.4.3",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
